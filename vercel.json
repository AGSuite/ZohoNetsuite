{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "agsuitetech.com"
        }
      ],
      "destination": "https://www.agsuitetech.com/:path*",
      "permanent": true
    },
    {
      "source": "/index.php",
      "destination": "/",
      "permanent": true
    }
  ]
}
